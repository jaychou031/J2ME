static char k_data_root[] =
    "A:\\" "\xd3\xa6\xd3\xc3" "\\" "\xca\xfd\xbe\xdd";
static char k_midp_home_gbk[] =
    "A:\\" "\xd3\xa6\xd3\xc3" "\\" "\xca\xfd\xbe\xdd" "\\J2ME";
static char k_midp_appdb_gbk[] =
