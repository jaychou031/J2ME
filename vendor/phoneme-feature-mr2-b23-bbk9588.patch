diff --git a/pcsl/file/bbk9588/GNUmakefile b/pcsl/file/bbk9588/GNUmakefile
new file mode 100644
index 0000000000000000000000000000000000000000..cf69f263e067bc950d1f9305b77200606b679c73
--- /dev/null
+++ b/pcsl/file/bbk9588/GNUmakefile
@@ -0,0 +1,37 @@
+# phoneME PCSL file adapter for the freestanding BBK9588 BDA target.
+PCSL_DIR = $(CURDIR)/../../
+FILE_MODULE = bbk9588
+
+ifdef PCSL_PLATFORM
+include $(PCSL_DIR)/makefiles/top.gmk
+endif
+
+ifndef BBK9588_PORT_DIR
+$(error BBK9588_PORT_DIR must point at src/platform/bbk9588)
+endif
+
+LIBNAME = $(OUTPUT_LIB_DIR)/libpcsl_file$(LIB_EXT)
+OBJS = $(OUTPUT_OBJ_DIR)/phoneme_pcsl_file.o
+
+all: verify $(OUTPUT_OBJ_DIR) $(OUTPUT_LIB_DIR) $(OUTPUT_INC_DIR) $(LIBNAME)
+	@cp -f ../pcsl_file.h $(OUTPUT_INC_DIR)
+	@cp -f ../pcsl_directory.h $(OUTPUT_INC_DIR)
+
+include $(PCSL_DIR)/makefiles/verify.gmk
+
+$(LIBNAME): $(OBJS)
+	@rm -f $(LIBNAME)
+	@$(AR) $(AR_OUTPUT)$(LIBNAME) `$(call fixcygpath, $^)`
+	@ranlib $(LIBNAME)
+
+$(OUTPUT_OBJ_DIR)/phoneme_pcsl_file.o: $(BBK9588_PORT_DIR)/phoneme_pcsl_file.c
+	@$(CC) -I.. -I$(OUTPUT_INC_DIR) $(CFLAGS) $(CC_OUTPUT)$@ \
+	    `$(call fixcygpath, $<)`
+
+$(OUTPUT_OBJ_DIR) $(OUTPUT_LIB_DIR) $(OUTPUT_INC_DIR):
+	@mkdir -p $@
+
+clean: verify
+	rm -f $(OBJS) $(LIBNAME)
+
+.PHONY: all clean verify
diff --git a/pcsl/makefiles/platforms/linux_mips_gcc.gmk b/pcsl/makefiles/platforms/linux_mips_gcc.gmk
new file mode 100644
index 0000000000000000000000000000000000000000..700f83946cfb5abf7d9ef38c7340a026532696d2
--- /dev/null
+++ b/pcsl/makefiles/platforms/linux_mips_gcc.gmk
@@ -0,0 +1,16 @@
+# Cross-build PCSL objects for the little-endian MIPS BDA target.  The BDA
+# supplies its own file, network, and print ports at final link time.
+PCSL_OS=linux
+PCSL_CPU=mips
+
+PCSL_CHUNKMEM_IMPL=pcsl_chunkheap
+PCSL_CHUNKMEM_DIR=$(PCSL_DIR)/memory/heap
+
+include $(PCSL_DIR)/makefiles/share/gcc.gmk
+include $(PCSL_DIR)/makefiles/share/linux.gmk
+
+FILE_MODULE=bbk9588
+
+CFLAGS += -EL -march=mips32 -msoft-float -mno-abicalls -G0 -fno-pic \
+    -ffreestanding -fno-builtin -ffunction-sections -fdata-sections \
+    -I$(BBK9588_INCLUDE_DIR) -I$(BBK9588_SDK_INCLUDE_DIR)
diff --git a/pcsl/memory/memory_port/bbk9588/pcsl_memory_port.c b/pcsl/memory/memory_port/bbk9588/pcsl_memory_port.c
new file mode 100644
index 0000000000000000000000000000000000000000..8e524c637f40ce2bf6ded2d2e40c9e439712ab21
--- /dev/null
+++ b/pcsl/memory/memory_port/bbk9588/pcsl_memory_port.c
@@ -0,0 +1,7 @@
+#include <pcsl_memory_port.h>
+
+void *pcsl_heap_allocate_port_impl(long size, long *outSize) {
+    void *pointer = malloc((unsigned long)size);
+    *outSize = pointer == 0 ? 0 : size;
+    return pointer;
+}
