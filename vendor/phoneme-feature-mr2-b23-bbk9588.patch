+#define pcsl_realloc_port_impl(x,y) realloc((x),(y))
+#define pcsl_calloc_port_impl(x,y) calloc((x),(y))
+#define pcsl_strdup_port_impl(x) strdup((x))
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
