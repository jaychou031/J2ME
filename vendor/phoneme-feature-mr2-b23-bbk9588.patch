 /** Maximum number of command line arguments. */
 #define RUNMIDLET_MAX_ARGS 32
 
+volatile int j2me_phoneme_run_stage = 0;
+volatile int j2me_phoneme_run_status = 0;
+
+/*
+ * The stock development launcher only discovers a MIDlet class for an
+ * installed suite.  The 9588 launcher deliberately runs the selected JAR
+ * directly, so obtain MIDlet-1 from its manifest without installing/copying
+ * the game first.  This also keeps startup time and storage use down.
+ */
+static int
+classFromExternalJar(const char* jarPath, pcsl_string* className) {
+    static const char manifestName[] = "META-INF/MANIFEST.MF";
+    pcsl_string jar = PCSL_STRING_NULL;
+    pcsl_string manifest = PCSL_STRING_NULL;
+    unsigned char* data = NULL;
+    void* handle = NULL;
+    long size;
+    int error = 0;
+    int result = 0;
+
+    if (PCSL_STRING_OK != pcsl_string_from_chars(jarPath, &jar) ||
+            PCSL_STRING_OK != pcsl_string_from_chars(manifestName,
+                &manifest)) {
+        goto cleanup;
+    }
+
+    handle = midpOpenJar(&error, &jar);
+    if (handle == NULL || error != 0) {
+        goto cleanup;
+    }
+    size = midpGetJarEntry(handle, &manifest, &data);
+    if (size > 0 && data != NULL) {
+        long at = 0;
+        while (at < size) {
+            long lineStart = at;
+            long lineEnd;
+            long comma = -1;
+            long valueEnd;
+            char buffer[256];
+            int length;
+
+            while (at < size && data[at] != '\r' && data[at] != '\n') {
+                ++at;
+            }
+            lineEnd = at;
+            while (at < size && (data[at] == '\r' || data[at] == '\n')) {
+                ++at;
+            }
+            if (lineEnd - lineStart < 9 ||
+                    memcmp(data + lineStart, "MIDlet-1:", 9) != 0) {
+                continue;
+            }
+            while (lineStart < lineEnd) {
+                if (data[lineStart] == ',') {
+                    comma = lineStart;
+                }
+                ++lineStart;
+            }
+            if (comma < 0) {
+                break;
+            }
+            ++comma;
+            while (comma < lineEnd &&
+                    (data[comma] == ' ' || data[comma] == '\t')) {
+                ++comma;
+            }
+            valueEnd = lineEnd;
+            while (valueEnd > comma &&
+                    (data[valueEnd - 1] == ' ' ||
+                     data[valueEnd - 1] == '\t')) {
+                --valueEnd;
+            }
+            length = (int)(valueEnd - comma);
+            if (length <= 0 || length >= (int)sizeof(buffer)) {
+                break;
+            }
+            memcpy(buffer, data + comma, (size_t)length);
+            buffer[length] = '\0';
+            if (PCSL_STRING_OK == pcsl_string_from_chars(buffer,
+                    className)) {
+                result = 1;
+            }
+            break;
+        }
+    }
+
+cleanup:
+    if (data != NULL) {
+        midpFree(data);
+    }
+    if (handle != NULL) {
+        midpCloseJar(handle);
+    }
+    pcsl_string_free(&manifest);
+    pcsl_string_free(&jar);
+    return result;
+}
