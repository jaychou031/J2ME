index 0000000000000000000000000000000000000000..5f5d616e643852e658e7be32c630d307df61191a
--- /dev/null
+++ b/midp/src/media/reference/classes/javax/microedition/media/BBK9588Player.java
@@ -0,0 +1,241 @@
+/*
+ * Copyright 2026 J2ME-for9588 contributors.
+ *
+ * This file is distributed under the same GPLv2 terms as phoneME Feature.
+ */
+package javax.microedition.media;
+
+import java.util.Vector;
+import javax.microedition.media.control.VolumeControl;
+
+/** Small single-device MMAPI player backed by the BBK9588 raw PCM port. */
+final class BBK9588Player implements Player, VolumeControl {
+    static final int KIND_MIDI = 1;
+    static final int KIND_WAV = 2;
+    static final int MAX_MEDIA_BYTES = 512 * 1024;
+
+    private final byte[] data;
+    private final String contentType;
+    private final int kind;
+    private final Vector listeners = new Vector(1);
+    private int state = UNREALIZED;
+    private int loopCount = 1;
+    private int level = 100;
+    private boolean muted;
+    private long mediaTime;
+
+    BBK9588Player(byte[] data, String contentType, int kind) {
+        this.data = data;
+        this.contentType = contentType;
+        this.kind = kind;
+    }
+
+    static int kindFor(String contentType) {
+        if (contentType == null) {
+            return 0;
+        }
+        String type = contentType.toLowerCase();
+        if ("audio/midi".equals(type) || "audio/mid".equals(type) ||
+                "audio/x-midi".equals(type) || "audio/sp-midi".equals(type)) {
+            return KIND_MIDI;
+        }
+        if ("audio/wav".equals(type) || "audio/wave".equals(type) ||
+                "audio/x-wav".equals(type) || "audio/x-pn-wav".equals(type)) {
+            return KIND_WAV;
+        }
+        return 0;
+    }
+
+    public synchronized void realize() throws MediaException {
+        checkOpen();
+        if (state == UNREALIZED) {
+            state = REALIZED;
+        }
+    }
+
+    public synchronized void prefetch() throws MediaException {
+        realize();
+        if (state < PREFETCHED) {
+            state = PREFETCHED;
+        }
+    }
+
+    public synchronized void start() throws MediaException {
+        prefetch();
+        if (state == STARTED) {
+            return;
+        }
+        if (!nativeStart(data, kind, loopCount, muted ? 0 : level)) {
+            throw new MediaException("Unsupported or invalid audio data");
+        }
+        state = STARTED;
+        mediaTime = 0;
+        notifyListeners(PlayerListener.STARTED, null);
+    }
+
+    public synchronized void stop() throws MediaException {
+        checkOpen();
+        if (state == STARTED) {
+            mediaTime = nativeMediaTime();
+            nativeStop();
+            state = PREFETCHED;
+            notifyListeners(PlayerListener.STOPPED, null);
+        }
+    }
+
+    public synchronized void deallocate() {
+        if (state == CLOSED || state == UNREALIZED) {
+            return;
+        }
+        if (state == STARTED) {
+            mediaTime = nativeMediaTime();
+            nativeStop();
+        }
+        state = REALIZED;
+    }
+
+    public synchronized void close() {
+        if (state == CLOSED) {
+            return;
+        }
+        if (state == STARTED) {
+            nativeStop();
+        }
+        state = CLOSED;
+        notifyListeners(PlayerListener.CLOSED, null);
+        listeners.removeAllElements();
+    }
+
+    public synchronized long setMediaTime(long now) throws MediaException {
+        checkOpen();
+        if (now < 0) {
+            now = 0;
+        }
+        if (state == STARTED) {
+            nativeStop();
+            state = PREFETCHED;
+        }
+        mediaTime = now == 0 ? 0 : now;
+        return mediaTime;
+    }
+
+    public synchronized long getMediaTime() {
+        if (state == STARTED) {
+            mediaTime = nativeMediaTime();
+        }
+        return mediaTime;
+    }
+
+    public synchronized int getState() {
+        if (state == STARTED && !nativeIsPlaying()) {
+            mediaTime = nativeMediaTime();
+            state = PREFETCHED;
+            notifyListeners(PlayerListener.END_OF_MEDIA, null);
+        }
+        return state;
+    }
+
+    public long getDuration() {
+        return TIME_UNKNOWN;
+    }
+
+    public String getContentType() {
+        return contentType;
+    }
+
+    public synchronized void setLoopCount(int count) {
+        checkOpen();
+        if (count == 0 || count < -1) {
+            throw new IllegalArgumentException("bad loop count");
+        }
+        if (state == STARTED) {
+            throw new IllegalStateException("already started");
+        }
+        loopCount = count;
+    }
+
+    public synchronized void addPlayerListener(PlayerListener listener) {
+        checkOpen();
+        if (listener != null && !listeners.contains(listener)) {
+            listeners.addElement(listener);
+        }
+    }
+
+    public synchronized void removePlayerListener(PlayerListener listener) {
+        checkOpen();
+        listeners.removeElement(listener);
+    }
+
+    public Control[] getControls() {
+        checkOpen();
+        return new Control[] { this };
+    }
+
+    public Control getControl(String controlType) {
+        checkOpen();
+        if (controlType == null) {
+            throw new IllegalArgumentException("null control");
+        }
+        if ("VolumeControl".equals(controlType) ||
+                "javax.microedition.media.control.VolumeControl".equals(controlType)) {
+            return this;
+        }
+        return null;
+    }
+
+    public synchronized void setMute(boolean mute) {
+        checkOpen();
+        if (muted != mute) {
+            muted = mute;
+            if (state == STARTED) {
+                nativeSetVolume(muted ? 0 : level);
+            }
+            notifyListeners(PlayerListener.VOLUME_CHANGED, this);
+        }
+    }
+
+    public boolean isMuted() {
+        return muted;
+    }
+
+    public synchronized int setLevel(int newLevel) {
+        checkOpen();
+        if (newLevel < 0) {
+            newLevel = 0;
+        } else if (newLevel > 100) {
+            newLevel = 100;
+        }
+        if (level != newLevel) {
+            level = newLevel;
+            if (state == STARTED && !muted) {
+                nativeSetVolume(level);
+            }
+            notifyListeners(PlayerListener.VOLUME_CHANGED, this);
+        }
+        return level;
+    }
+
+    public int getLevel() {
+        return level;
+    }
+
+    private void checkOpen() {
+        if (state == CLOSED) {
+            throw new IllegalStateException("player is closed");
+        }
+    }
+
+    private void notifyListeners(String event, Object data) {
+        for (int i = 0; i < listeners.size(); i++) {
+            ((PlayerListener)listeners.elementAt(i)).playerUpdate(this, event, data);
+        }
+    }
+
+    static native void playTone(int note, int duration, int volume);
+    private static native boolean nativeStart(byte[] data, int kind,
+        int loops, int volume);
+    private static native void nativeStop();
+    private static native void nativeSetVolume(int volume);
+    private static native boolean nativeIsPlaying();
+    private static native long nativeMediaTime();
+}
