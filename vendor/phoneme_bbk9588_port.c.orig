#define PHONEME_INPUT_ARM_MS 350u
#define PHONEME_RAW_EVENT_DRAIN_LIMIT 4u
#define PHONEME_KEY_UP_MASK (1u << 0)
#define PHONEME_KEY_DOWN_MASK (1u << 1)
#define PHONEME_KEY_LEFT_MASK (1u << 2)
#define PHONEME_KEY_RIGHT_MASK (1u << 3)
#define PHONEME_KEY_ESCAPE_MASK (1u << 4)
#define PHONEME_KEY_ENTER_MASK (1u << 5)
#define SOFTPAD_FLOAT_RADIUS 15
#define SOFTPAD_FLOAT_HIT_RADIUS 22
#define SOFTPAD_DRAG_THRESHOLD_SQUARED 144
#define SOFTPAD_PANEL_X 33
#define SOFTPAD_PANEL_WIDTH 174
#define SOFTPAD_PANEL_HEIGHT 232
#define SOFTPAD_INNER_X 42
#define SOFTPAD_ACTION_Y 8
#define SOFTPAD_ACTION_WIDTH 36
#define SOFTPAD_ACTION_HEIGHT 28
#define SOFTPAD_ACTION_GAP_X 4
#define SOFTPAD_VOLUME_BAR_Y 38
#define SOFTPAD_VOLUME_BAR_HEIGHT 3
#define SOFTPAD_LR_Y 44
#define SOFTPAD_LR_HEIGHT 30
#define SOFTPAD_NUMERIC_Y 80
#define SOFTPAD_KEY_WIDTH 48
#define SOFTPAD_KEY_HEIGHT 32
#define SOFTPAD_KEY_GAP_X 6
#define SOFTPAD_KEY_GAP_Y 5
#define SOFTPAD_DIRTY_RECT_LIMIT 6

#define SOFTPAD_ACTION_EXIT (-1001)
#define SOFTPAD_ACTION_VOLUME_DOWN (-1002)
#define SOFTPAD_ACTION_MUTE (-1003)
#define SOFTPAD_ACTION_VOLUME_UP (-1004)

enum {
    SOFTPAD_TOUCH_NONE = 0,
    SOFTPAD_TOUCH_GAME = 1,
    SOFTPAD_TOUCH_FLOAT = 2,
    SOFTPAD_TOUCH_KEY = 3,
    SOFTPAD_TOUCH_PANEL = 4,
    SOFTPAD_TOUCH_ACTION = 5
};

gxj_screen_buffer gxj_system_screen_buffer;

